// Build settings for the Dolphin core on Apple Silicon (arm64).
//
// The Xcode project predates the dolphin revision it is built against and does
// not know every include directory or source of it, so the missing pieces are
// supplied from here instead of editing each target.
//
// Invoke it with -xcconfig on the command line, see Readme.md:
//   xcodebuild ... -xcconfig openemu-arm64.xcconfig ...
// For playable builds use openemu-arm64-release.xcconfig, which includes this
// file and adds NDEBUG.

// Directory of the arm64 OpenEmuBase.framework/OpenEmuSystem.framework build
// products, produced by the OpenEmu workspace build. Override on the command
// line when your build output lives elsewhere:
//   OE_OPENEMU_BUILD_DIR=/path/to/Build/Products/Debug
OE_OPENEMU_BUILD_DIR = /tmp/oe_arm64/Build/Products/Debug

// - glslang/build_info.h is generated by CMake upstream, not by this project.
//   Readme.md documents the command that recreates it here.
// - Externals/expr is vendored in the tree but missing from HEADER_SEARCH_PATHS
//   (Core/PowerPC/Expression.cpp).
// - cubeb's bundled speex resampler is included as <speex/speex_resampler.h>,
//   so the parent of that directory has to be searchable.
// - Externals/tinygltf is missing from HEADER_SEARCH_PATHS (VideoCommon/Assets/MeshAsset.cpp).
// - Compatibility/miniunpnpc holds the pre-generated miniupnpcstrings.h, but its
//   directory is not part of the miniupnpc target's header search paths.
// - Externals/FatFs provides ff.h for the WiiConnect24 VFF filesystem code,
//   which upstream adds to the include path but the project does not.
// - imPlot is only used by the performance metrics overlay and is included as
//   <implot.h>, but its directory is not in the header search paths.
// - lz4.h is included as <lz4.h> by Core/State.cpp; upstream links the vendored
//   lz4 as its own static library, which this project does not have.
// - glslang headers are included both as <glslang/Public/...> and as
//   <glslang/SPIRV/...>, which live one directory apart in the vendored tree.
// Note: mbedtls' library/ directory is deliberately not searched here. liblzma
// has its own "common.h" and is compiled with this configuration too, so a
// global entry would shadow it. The path is set on the mbedtls target instead.
OE_DOLPHIN_GEN_DIR = $(SRCROOT)/build/gen
HEADER_SEARCH_PATHS = $(OE_DOLPHIN_GEN_DIR) $(SRCROOT)/dolphin/Externals/expr/include $(SRCROOT)/dolphin/Externals/cubeb/cubeb/subprojects $(SRCROOT)/dolphin/Externals/tinygltf $(SRCROOT)/dolphin/Externals/FatFs $(SRCROOT)/dolphin/Externals/implot/implot $(SRCROOT)/dolphin/Externals/lz4/lz4/lib $(SRCROOT)/dolphin/Externals/glslang/glslang $(SRCROOT)/dolphin/Externals/glslang $(SRCROOT)/Compatibility/miniunpnpc $(inherited)

// The cores are OpenEmu plug-ins for 12.0 and later; the SDK the project was
// created against no longer exists.
MACOSX_DEPLOYMENT_TARGET = 12.0
FRAMEWORK_SEARCH_PATHS = $(inherited) $(OE_OPENEMU_BUILD_DIR)
